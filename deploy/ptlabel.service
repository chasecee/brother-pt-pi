[Unit]
Description=ptlabel web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__PTLABEL_USER__
Group=__PTLABEL_USER__
WorkingDirectory=__PTLABEL_ROOT__
Environment=PTLABEL_ROOT=__PTLABEL_ROOT__
Environment=PTLABEL_DATA_DIR=__PTLABEL_ROOT__/data
ExecStart=__PTLABEL_ROOT__/bin/ptlabel-server --port 5000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
