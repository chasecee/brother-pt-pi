---
import { SETTINGS } from "../scripts/lucide-icons";
---

<header class="topbar">
  <h1>
    Label printer <span id="status" class="checking">checking...</span>
  </h1>
  <button
    id="settingsBtn"
    type="button"
    class="cog"
    aria-label="System info"
    aria-expanded="false"
    aria-controls="systemPanel"
    set:html={SETTINGS}
  >
  </button>
</header>
