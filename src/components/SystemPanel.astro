<div id="systemPanel" class="system-panel">
  <div class="system-panel-inner">
    <div class="settings-group">
      <label class="settings-field">
        <span>Margin</span>
        <input id="prefMargin" type="number" min="0" max="128" step="1" />
      </label>
      <label class="settings-field">
        <span>V align</span>
        <input id="prefVAlign" type="number" min="-32" max="32" step="1" />
      </label>
    </div>
    <div class="stat-row">
      <span>Memory</span><span id="statMem">—</span>
    </div>
    <div class="stat-row">
      <span>Wi-Fi</span><span id="statWifi">—</span>
    </div>
    <div class="stat-row">
      <span>CPU temp</span><span id="statTemp">—</span>
    </div>
    <div class="stat-row">
      <span>Uptime</span><span id="statUptime">—</span>
    </div>
    <div class="stat-row">
      <span>Deployed</span><span id="statDeployed">—</span>
    </div>
    <div class="stat-row">
      <a
        href="https://github.com/chasecee/brother-pt-pi/actions"
        target="_blank"
        rel="noopener">GitHub Actions</a
      >
    </div>
  </div>
</div>
