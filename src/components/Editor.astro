---
import { ROW_ADD } from "../scripts/lucide-icons";
---

<main class="editor">
  <section id="stage" class="stage" aria-label="Label preview and editor">
    <div id="rows" class="rows" role="list"></div>
  </section>

  <section
    id="drawer"
    class="drawer"
    data-mode="empty"
    aria-live="polite"
  >
    <svg
      class="drawer-pointer"
      viewBox="0 0 38 21"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path class="drawer-pointer-fill" d="M0 19 L19 0 L38 19 L38 21 L0 21 Z" />
      <polyline
        class="drawer-pointer-stroke"
        points="0,19 19,0 38,19"
      />
    </svg>
  </section>

  <div class="stage-foot">
    <button id="rowAdd" type="button" class="row-add">
      <span set:html={ROW_ADD} />
      <span>New</span>
    </button>
    <button id="printBtn" type="button" class="btn btn-primary">
      Print
    </button>
  </div>
</main>
