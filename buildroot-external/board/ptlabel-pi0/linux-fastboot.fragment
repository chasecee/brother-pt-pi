# PTLabel Pi Zero W fast-boot kernel trim
CONFIG_BT=n
CONFIG_SOUND=n
CONFIG_SND=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_USB_GADGET=n
CONFIG_NFSD=n
CONFIG_NFS_FS=n
CONFIG_CIFS=n
CONFIG_IPV6=n
CONFIG_REISERFS_FS=n
CONFIG_JFS_FS=n
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_F2FS_FS=n
CONFIG_UDF_FS=n
CONFIG_ISO9660_FS=n
CONFIG_ROMFS_FS=n
CONFIG_SQUASHFS=n
CONFIG_OVERLAY_FS=n
# brcmfmac stays =m (bcmrpi default): built-in would probe the SDIO bus before
# the rootfs holding its firmware is mounted. S05wifi modprobes it explicitly.
# Uncompressed modules: BusyBox modprobe cannot load .ko.xz (no kmod on image).
CONFIG_MODULE_COMPRESS_NONE=y
CONFIG_MODULE_COMPRESS_XZ=n
