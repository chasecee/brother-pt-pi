#!/usr/bin/env sh
set -eu

NAME=ptlabel-diagnostics
PIDFILE=/var/run/ptlabel-diagnostics.pid
BIN=/usr/bin/ptlabel-diagnostics

start() {
  [ -x "$BIN" ] || return 1
  mkdir -p /var/run
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    return 0
  fi
  "$BIN" >/dev/null 2>&1 &
  echo $! >"$PIDFILE"
}

stop() {
  if [ -f "$PIDFILE" ]; then
    pid="$(cat "$PIDFILE" || true)"
    if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" || true
    fi
    rm -f "$PIDFILE"
  fi
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  *) echo "usage: $0 {start|stop|restart}" ; exit 1 ;;
esac
