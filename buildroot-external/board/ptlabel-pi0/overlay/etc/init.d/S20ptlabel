#!/usr/bin/env sh
set -eu

NAME=ptlabel-bridge
PIDFILE=/var/run/ptlabel-bridge.pid
ENVFILE=/etc/default/ptlabel
BOOT_LOG=/var/log/ptlabel/boot.log

[ -r "$ENVFILE" ] && . "$ENVFILE"

ROOT="${PTLABEL_ROOT:-/opt/ptlabel}"
PORT="${PTLABEL_PORT:-7777}"
MDNS_NAME="${PTLABEL_MDNS_NAME:-bridge}"
EXTRA_ARGS="${PTLABEL_EXTRA_ARGS:-}"
BIN="$ROOT/bin/ptlabel-bridge"
export PTLABEL_MDNS_NAME="$MDNS_NAME"

boot_uptime() {
  awk '{print $1}' /proc/uptime 2>/dev/null || echo "n/a"
}

start() {
  [ -x "$BIN" ] || return 1
  mkdir -p /var/run /var/log/ptlabel
  printf '[init] S20ptlabel start uptime=%ss\n' "$(boot_uptime)" >>"$BOOT_LOG"
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    return 0
  fi
  cd "$ROOT"
  "$BIN" --port "$PORT" --mdns-name "$MDNS_NAME" $EXTRA_ARGS >>/var/log/ptlabel/bridge.log 2>&1 &
  echo $! >"$PIDFILE"
}

stop() {
  if [ -f "$PIDFILE" ]; then
    pid="$(cat "$PIDFILE" || true)"
    if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" || true
      sleep 1
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
  fi
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  *) echo "usage: $0 {start|stop|restart}" ; exit 1 ;;
esac
