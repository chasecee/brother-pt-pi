#!/usr/bin/env sh
set -eu

NAME=ptlabel-server
PIDFILE=/var/run/ptlabel.pid
ENVFILE=/etc/default/ptlabel

[ -r "$ENVFILE" ] && . "$ENVFILE"

ROOT="${PTLABEL_ROOT:-/opt/ptlabel}"
DATA_DIR="${PTLABEL_DATA_DIR:-$ROOT/data}"
PORT="${PTLABEL_PORT:-443}"
MDNS_NAME="${PTLABEL_MDNS_NAME:-label}"
EXTRA_ARGS="${PTLABEL_EXTRA_ARGS:-}"
BIN="$ROOT/bin/ptlabel-server"
export PTLABEL_MDNS_NAME="$MDNS_NAME"

start() {
  [ -x "$BIN" ] || return 1
  mkdir -p "$DATA_DIR" /var/run /var/log/ptlabel
  if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    return 0
  fi
  cd "$ROOT"
  PTLABEL_ROOT="$ROOT" PTLABEL_DATA_DIR="$DATA_DIR" PTLABEL_MDNS_NAME="$MDNS_NAME" \
    "$BIN" --port "$PORT" --mdns-name "$MDNS_NAME" $EXTRA_ARGS >>/var/log/ptlabel/server.log 2>&1 &
  echo $! >"$PIDFILE"
}

stop() {
  if [ -f "$PIDFILE" ]; then
    pid="$(cat "$PIDFILE" || true)"
    if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" || true
      sleep 1
      kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PIDFILE"
  fi
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  *) echo "usage: $0 {start|stop|restart}" ; exit 1 ;;
esac
